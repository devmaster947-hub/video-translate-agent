MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_TTS_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=

# Remote policy workflow. Authentication is handled by LZStudio CLI, not n8n.
LINGZHI_API_KEY=
LZSTUDIO_CLI=
VIDEO_TRANSLATE_POLICY_WORKFLOW_ID=VideoTranslatePolicyV1
